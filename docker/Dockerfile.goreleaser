FROM ghcr.io/goreleaser/goreleaser-cross:v1.27.3@sha256:1820cee53c4c06cfb43c2203caca73f9497042f5b6061c8916a251228a321975

RUN apt-get update --allow-releaseinfo-change || apt-get update; apt-get install -y openssh-client

ARG SYFT_VERSION=1.55.0
ARG SYFT_SHA256=070620d4a7ed6a2fbca67dae6cd0622c05354b351e171f325f0a3c9e7f42adab
RUN wget -O syft.deb https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.deb && echo "${SYFT_SHA256}  syft.deb" | sha256sum -c - && dpkg -i syft.deb

RUN mv /entrypoint.sh /base-entrypoint.sh
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
